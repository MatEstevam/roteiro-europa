generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TripPace {
  slow
  balanced
  intense
}

enum BudgetLevel {
  economic
  moderate
  comfortable
}

enum TripStatus {
  draft
  generated
  saved
}

enum TravelerType {
  adult
  child
}

// ─── Auth.js Models ───────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Application Models ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  trips         Trip[]
  flightSearches FlightSearch[]
  savedPlaces   SavedPlace[]
}

model Trip {
  id                        String      @id @default(uuid()) @db.Uuid
  userId                    String?     @db.Uuid
  title                     String
  startDate                 DateTime
  endDate                   DateTime
  originCity                String
  originAirport             String?
  pace                      TripPace
  budgetLevel               BudgetLevel
  interests                 String[]
  transportationPreferences String[]
  accessibilityNeeds        String?
  dietaryPreferences        String[]
  mandatoryPlaces           String[]
  acceptAlternativeAirports Boolean     @default(false)
  maxAirportDistance        Int?
  shareToken                String?     @unique @db.Uuid
  status                    TripStatus  @default(draft)
  generatedItinerary        Json?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  user           User?           @relation(fields: [userId], references: [id])
  travelers      TripTraveler[]
  countries      TripCountry[]
  cities         TripCity[]
  itineraryDays  ItineraryDay[]
  flightSearches FlightSearch[]
}

model TripTraveler {
  id     String       @id @default(uuid()) @db.Uuid
  tripId String       @db.Uuid
  type   TravelerType
  age    Int?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripCountry {
  id      String @id @default(uuid()) @db.Uuid
  tripId  String @db.Uuid
  country String
  order   Int

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripCity {
  id             String   @id @default(uuid()) @db.Uuid
  tripId         String   @db.Uuid
  city           String
  country        String
  arrivalDate    DateTime
  departureDate  DateTime
  numberOfNights Int
  order          Int
  imageUrl       String?
  description    String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model ItineraryDay {
  id               String  @id @default(uuid()) @db.Uuid
  tripId           String  @db.Uuid
  dayNumber        Int
  date             DateTime
  city             String
  country          String
  title            String
  summary          String?
  estimatedCostMin Float
  estimatedCostMax Float
  currency         String  @default("BRL")

  trip       Trip                @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities ItineraryActivity[]
}

model ItineraryActivity {
  id                  String   @id @default(uuid()) @db.Uuid
  dayId               String   @db.Uuid
  name                String
  description         String?
  category            String
  date                DateTime
  startTime           DateTime
  endTime             DateTime
  durationMinutes     Int
  estimatedCostMin    Float    @default(0)
  estimatedCostMax    Float    @default(0)
  currency            String   @default("BRL")
  openingHours        Json?
  address             String?
  latitude            Float?
  longitude           Float?
  imageUrl            String?
  bookingRecommended  Boolean  @default(false)
  bookingUrl          String?
  website             String?
  source              String?
  sourcePlaceId       String?
  lastCheckedAt       DateTime?
  order               Int
  notes               String[]

  day ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model FlightSearch {
  id            String   @id @default(uuid()) @db.Uuid
  tripId        String?  @db.Uuid
  userId        String?  @db.Uuid
  origin        String
  destination   String
  departureDate DateTime
  returnDate    DateTime?
  adults        Int
  children      Int      @default(0)
  cabinClass    String   @default("economy")
  directOnly    Boolean  @default(false)
  maxStops      Int?
  provider      String
  searchedAt    DateTime @default(now())

  trip   Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user   User?         @relation(fields: [userId], references: [id])
  offers FlightOffer[]
}

model FlightOffer {
  id               String   @id @default(uuid()) @db.Uuid
  searchId         String   @db.Uuid
  airline          String
  airlineLogo      String?
  totalPrice       Float
  pricePerPerson   Float
  currency         String   @default("BRL")
  departureAirport String
  arrivalAirport   String
  departureTime    DateTime
  arrivalTime      DateTime
  durationMinutes  Int
  stops            Int      @default(0)
  stopDetails      Json?
  baggageIncluded  Boolean?
  bookingUrl       String?
  balanceScore     Float?
  provider         String
  lastUpdatedAt    DateTime

  search FlightSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
}

model SavedPlace {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  city      String
  country   String
  placeId   String?
  notes     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiCache {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  type      String
  data      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([type, expiresAt])
}
