# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/roteiro_europa

# Auth.js (required)
NEXTAUTH_SECRET=your-random-secret-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional - for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Amadeus Flight Search (optional - enables real flight search)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Google Places (optional - enables real attraction data)
GOOGLE_PLACES_API_KEY=

# Pexels Images (optional - enables real destination photos)
PEXELS_API_KEY=

# Skyscanner (optional - future integration)
SKYSCANNER_API_KEY=
