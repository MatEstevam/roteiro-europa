# Database (required) - Supabase PostgreSQL
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres"

# Auth.js (required)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional - for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Duffel Flight Search (optional - enables real flight search, preferred)
DUFFEL_API_TOKEN=

# Amadeus Flight Search (optional - alternative to Duffel)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Pexels Images (optional - enables real destination photos)
PEXELS_API_KEY=

# OpenAI (required for AI itinerary generation, fallback to deterministic without it)
OPENAI_API_KEY=sk-...

# Skyscanner (optional - future integration)
SKYSCANNER_API_KEY=
